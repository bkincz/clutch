{
  "name": "@bkincz/clutch",
  "version": "3.5.0",
  "description": "A TypeScript-first, plugin-based state management library built on Immer",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./sync-ws": {
      "types": "./dist/sync-ws.d.ts",
      "import": "./dist/sync-ws.mjs",
      "require": "./dist/sync-ws.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm run verify",
    "clean": "rimraf dist",
    "size": "size-limit",
    "verify": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build && pnpm run size"
  },
  "keywords": [
    "state-management",
    "immer",
    "react",
    "typescript",
    "undo-redo",
    "persistence",
    "immutable",
    "redux-alternative"
  ],
  "author": "Benjamin Kinczel <beni.kinczel@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bkincz/clutch.git"
  },
  "bugs": {
    "url": "https://github.com/bkincz/clutch/issues"
  },
  "homepage": "https://github.com/bkincz/clutch#readme",
  "peerDependencies": {
    "react": ">=16.8.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "immer": "^11.1.16",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "size-limit": "^13.0.3",
    "terser": "^5.49.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "name": "Core only",
      "path": "dist/index.mjs",
      "import": "{ createMachine }",
      "limit": "6 KB"
    },
    {
      "name": "React hooks",
      "path": "dist/react.mjs",
      "limit": "3 KB"
    },
    {
      "name": "Sync WS",
      "path": "dist/sync-ws.js",
      "limit": "4 KB"
    },
    {
      "name": "Full bundle",
      "path": "dist/index.mjs",
      "limit": "15 KB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.6.0"
}
